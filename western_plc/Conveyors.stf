PROGRAM prgQLD
#info= QLD


BOF 

(*Infeed conveyor enable*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[29]*) (**)  XIC  [2,1]  (*O0[19]*) (**)  OTE  [3,1]  (*Y3[1032]*) (**) 
EOR  [4,1]


(*Infeed off delay*)

SOR  [0,1] (**) (**)  XIO  [1,1]  (*X3[1024]*) (**)  FB  [2,1] (*TOF*) (*1*) ( (*IN:IN*)(**) (**)  , (*PT:PT*)(*TM0[1]*) (**) ; (*Q:Q*)(**) (**)  , (*ET:ET*)(*TM0[2]*) (**) )  OTE  [5,1]  (*I0[6]*) (**) 
EOR  [6,1]


(*Infeed Load pulse*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[15]*) (**)  FB  [2,1] (*TOF*) (*2*) ( (*IN:IN*)(**) (**)  , (*PT:PT*)(*TM0[5]*) (**) ; (*Q:Q*)(**) (**)  , (*ET:ET*)(*TM0[6]*) (**) )  OTE  [5,1]  (*I0[1005]*) (**) 
EOR  [6,1]


(*Infeed conveyor motor on*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*Y3[1032]*) (**) 
 BST 
 BST  XIC  [2,1]  (*O0[9]*) (**)  XIO  [3,1]  (*O0[16]*) (**) 
	 NXB  XIL  [2,2]  (**) (**)  XIC  [3,2]  (*O0[35]*) (**) 
 BND 
 XIC  [4,1]  (*X3[1025]*) (**)  XIO  [5,1]  (*O0[16]*) (**) 
	 NXB  XIC  [2,3]  (*O0[16]*) (**)  XIL  [3,3]  (**) (**)  XIC  [4,3]  (*I0[1005]*) (**) 
 BND 
 XIC  [6,1]  (*X3[1025]*) (**)  OTE  [7,1]  (*Y3[1033]*) (**) 
EOR  [8,1]


(*Outfeed conveyor enable*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[29]*) (**)  XIC  [2,1]  (*O0[19]*) (**)  OTE  [3,1]  (*Y3[1034]*) (**) 
EOR  [4,1]


(*Outfeed off delay*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[13]*) (**)  FB  [2,1] (*TOF*) (*3*) ( (*IN:IN*)(**) (**)  , (*PT:PT*)(*TM0[3]*) (**) ; (*Q:Q*)(**) (**)  , (*ET:ET*)(*TM0[4]*) (**) )  OTE  [5,1]  (*I0[7]*) (**) 
EOR  [6,1]


(*Outfeed conveyor motor on*)

SOR  [0,1] (**) (**) 
 BST 
 BST  XIC  [1,1]  (*Y3[1034]*) (**) 
	 NXB  XIC  [1,2]  (*Y3[1034]*) (**) 
 BND 
 XIC  [2,1]  (*O0[13]*) (**)  XIC  [3,1]  (*I0[7]*) (**)  XIO  [4,1]  (*X3[1026]*) (**) 
	 NXB  XIC  [1,3]  (*Y3[1034]*) (**)  XIC  [2,3]  (*O0[9]*) (**)  XIO  [3,3]  (*X3[1026]*) (**)  XIC  [4,3]  (*O0[22]*) (**) 
 BND 
 OTE  [5,1]  (*Y3[1035]*) (**) 
EOR  [6,1]


EOF
#end_info 
END_PROGRAM
