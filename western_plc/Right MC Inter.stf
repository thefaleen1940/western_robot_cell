PROGRAM prgQLD
#info= QLD


BOF 

(*MC2 RDY to load*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1010]*) (**)  OTE  [2,1]  (*I0[1010]*) (**) 
EOR  [3,1]


(*MC2 RDY *)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1011]*) (**)  OTE  [2,1]  (*I0[1011]*) (**) 
EOR  [3,1]


(*MC2 part clamped*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1012]*) (**)  OTE  [2,1]  (*I0[1012]*) (**) 
EOR  [3,1]


(*MC2 part unclamped*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1013]*) (**)  OTE  [2,1]  (*I0[1013]*) (**) 
EOR  [3,1]


(*MC2 door opened*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1014]*) (**)  OTE  [2,1]  (*I0[1014]*) (**) 
EOR  [3,1]


(*MC2 door closed*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1015]*) (**)  OTE  [2,1]  (*I0[1015]*) (**) 
EOR  [3,1]


(*MC 2 Fx 1 UnClamp*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1010]*) (**) 
	 NXB  XIC  [1,2]  (*O0[85]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1009]*) (**) 
EOR  [3,1]


(*MC 2 Clamp Fx 1*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1009]*) (**) 
	 NXB  XIC  [1,2]  (*O0[84]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1008]*) (**) 
EOR  [3,1]


(*MC2 clamp part*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1011]*) (**) 
	 NXB  XIC  [1,2]  (*O0[86]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1010]*) (**) 
EOR  [3,1]


(*MC2 unclamp part*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1012]*) (**) 
	 NXB  XIC  [1,2]  (*O0[87]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1011]*) (**) 
EOR  [3,1]


(*MC2 loading part*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1013]*) (**)  OTE  [2,1]  (*Y3[1012]*) (**) 
EOR  [3,1]


(*MC2 load complete*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1014]*) (**)  OTE  [2,1]  (*Y3[1013]*) (**) 
EOR  [3,1]


(*MC2 robot fault*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1015]*) (**)  OTE  [2,1]  (*Y3[1020]*) (**) 
EOR  [3,1]


(*MC2 Service Complete*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1016]*) (**)  OTE  [2,1]  (*Y3[1015]*) (**) 
EOR  [3,1]


EOF
#end_info 
END_PROGRAM
