PROGRAM prgQLD
#info= QLD


BOF 

(*MC1 RDY to load*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1002]*) (**)  OTE  [2,1]  (*I0[1002]*) (**) 
EOR  [3,1]


(*MC1 ready*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1003]*) (**)  OTE  [2,1]  (*I0[1003]*) (**) 
EOR  [3,1]


(*MC1 part clamped*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1004]*) (**)  OTE  [2,1]  (*I0[1004]*) (**) 
EOR  [3,1]


(*MC1 part unclamped*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1005]*) (**)  OTE  [2,1]  (*I0[1005]*) (**) 
EOR  [3,1]


(*MC1 door opened*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1006]*) (**)  OTE  [2,1]  (*I0[1006]*) (**) 
EOR  [3,1]


(*MC1 door closed*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1007]*) (**)  OTE  [2,1]  (*I0[1007]*) (**) 
EOR  [3,1]


(*MC1 door closed*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*X3[1008]*) (**)  OTE  [2,1]  (*I0[1008]*) (**) 
EOR  [3,1]


(*MC1 clamp F 2*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1003]*) (**) 
	 NXB  XIC  [1,2]  (*O0[82]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1002]*) (**) 
EOR  [3,1]


(*MC1 unclamp F 2*)

SOR  [0,1] (**) (**) 
 BST  XIC  [1,1]  (*O0[1004]*) (**) 
	 NXB  XIC  [1,2]  (*O0[83]*) (**) 
 BND 
 OTE  [2,1]  (*Y3[1003]*) (**) 
EOR  [3,1]


(*MC1 loading part*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1005]*) (**)  OTE  [2,1]  (*Y3[1004]*) (**) 
EOR  [3,1]


(*MC1 load complete*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1006]*) (**)  OTE  [2,1]  (*Y3[1005]*) (**) 
EOR  [3,1]


(*MC1 robot fault*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1007]*) (**)  OTE  [2,1]  (*Y3[1006]*) (**) 
EOR  [3,1]


(*MC1 robot fault*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1001]*) (**)  OTE  [2,1]  (*Y3[1000]*) (**) 
EOR  [3,1]


(*MC1 robot fault*)

SOR  [0,1] (**) (**)  XIC  [1,1]  (*O0[1002]*) (**)  OTE  [2,1]  (*Y3[1001]*) (**) 
EOR  [3,1]


EOF
#end_info 
END_PROGRAM
